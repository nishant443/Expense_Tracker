# Frontend env vars are PUBLIC (bundled into the browser). Never put secrets here.

# Leave unset to call same-origin /api (recommended: Vite proxy in dev, Vercel rewrite in prod).
# Only set when the API lives on a different origin AND the backend uses COOKIE_SAMESITE=none.
# VITE_API_URL=https://api.example.com

# Dev only: where the Vite proxy forwards /api
# VITE_DEV_API_TARGET=http://localhost:4000
