{
  "name": "expenseflow",
  "private": true,
  "version": "1.0.0",
  "description": "ExpenseFlow – premium offline-first personal finance PWA",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend"
  },
  "engines": { "node": ">=20.11" }
}
