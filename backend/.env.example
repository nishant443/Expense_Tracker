# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 on Render/Railway/Fly) — needed for correct rate limiting.
TRUST_PROXY=0

# ─── Database ────────────────────────────────────────────
# Neon (production): use the *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/expenseflow?sslmode=require
# Local zero-setup alternative (embedded Postgres via PGlite, data in ./.pglite):
DATABASE_URL=pglite:./.pglite
DATABASE_POOL_MAX=10

# ─── Auth ────────────────────────────────────────────────
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TTL_HOURS=24

# ─── Browser / cookies ───────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# 'lax' when the frontend proxies /api (same site — recommended). 'none' if the API is on another site.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ─── Email (optional in dev: links are printed to the console) ──
# Resend over HTTPS (recommended; works where SMTP ports are blocked, e.g. Render free)
# RESEND_API_KEY=re_xxx
# Or SMTP:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=ExpenseFlow <no-reply@example.com>

# Disable the in-process scheduler (e.g. when using an external cron)
DISABLE_JOBS=false
